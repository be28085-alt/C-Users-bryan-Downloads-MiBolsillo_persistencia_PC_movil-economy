# Template for DEVELOPMENT only. No passwords, session tokens or encryption keys.
# Copy to .env.development (ignored by Git) and run from the project root:
# node --env-file=.env.development scripts/serve-sqlite.cjs
# Qt helper: node --env-file=.env.development scripts/desktop-runtime.cjs
# Existing npm start behavior and database/mibolsillo.sqlite remain unchanged.
MIBOLSILLO_DB_PATH=database/development/mibolsillo.sqlite
MIBOLSILLO_ENV=development
MIBOLSILLO_HOST=127.0.0.1
PORT=5501
MIBOLSILLO_PORT=5501
# Test fixtures create their own temporary databases; never point tests at real data.
# Optional machine-specific executable paths (leave unset to use normal discovery):
# SQLITE_BROWSER_PATH=
# MIBOLSILLO_PROJECT_ROOT=
# MIBOLSILLO_NODE=
# Producción requiere TLS en un proxy explícito y escucha solo en loopback.
# MIBOLSILLO_ENV=production
# MIBOLSILLO_PUBLIC_ORIGIN=https://mibolsillo.example.test
# MIBOLSILLO_TRUSTED_PROXIES=127.0.0.1,::1,::ffff:127.0.0.1
# Solo para el conector MySQL archivado de Qt, si se utiliza por separado:
# MIBOLSILLO_MYSQL_PASSWORD=
